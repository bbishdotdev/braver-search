    {
      "name": "Weekly ordinary search users and redirect volume",
      "query": {
        "kind": "TrendsQuery",
        "dateRange": {
          "date_from": "-90d"
        },
        "interval": "week",
        "properties": [
          {
            "key": "analytics_version",
            "value": 2,
            "operator": "exact",
            "type": "event"
          },
          {
            "key": "environment",
            "value": [
              "production"
            ],
            "operator": "exact",
            "type": "event"
          }
        ],
        "series": [
          {
            "kind": "EventsNode",
            "event": "search_redirected",
            "math": "dau"
          },
          {
            "kind": "EventsNode",
            "event": "search_redirected",
            "math": "total"
          }
        ]
      }
    }
  ]
}
